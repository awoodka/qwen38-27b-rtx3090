+            ids = tokenizer.encode(form, add_special_tokens=False)
+            if len(ids) != 1:
+                dropped.append(f"{form!r} ({len(ids)} tokens)")
+            elif ids[0] in reserved:
+                dropped.append(f"{form!r} (a special token or reasoning marker)")
+            else:
+                kept[form] = ids[0]
+    return sorted(set(kept.values())), kept, dropped
