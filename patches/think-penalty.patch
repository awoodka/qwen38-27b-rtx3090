+        cached_last_start,
+        cached_last_end,
+        reasoning_start_token_ids,
+        natural_reasoning_end_token_ids,
+        penalty_token_ids,
+        penalty,
+        START_LEN=reasoning_start_token_ids.shape[0],
+        NATURAL_END_LEN=natural_reasoning_end_token_ids.shape[0],
+        NUM_PENALTY=num_penalty,
